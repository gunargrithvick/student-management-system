{
  "name": "student-details-website",
  "version": "2.0.0",
  "description": "Student Management System — REST API + web UI over MySQL, with auth, roles, and validation.",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "init-db": "node scripts/init-db.js",
    "seed": "node scripts/init-db.js --seed",
    "test": "node --test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "student-management",
    "express",
    "mysql",
    "rest-api"
  ],
  "author": "Guna Rithvick",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "morgan": "1.12.0",
    "mysql2": "3.24.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "supertest": "7.2.2"
  }
}
